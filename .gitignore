# ========================================
# GIT IGNORE - MiSuperProfe Backup
# ========================================
# Archivos y directorios que NO deben incluirse en la copia de seguridad git
# Fecha: 20 Julio 2025

# ========================================
# ARCHIVOS SENSIBLES Y CONFIGURACIÓN
# ========================================

# Variables de entorno (contienen credenciales)
.env
.env.local
.env.production
.env.staging

# Archivos de configuración del sistema
.bash_history*
.bash_logout
.profile
.sudo_as_admin_successful
.wget-hsts

# ========================================
# CACHÉS Y ARCHIVOS TEMPORALES
# ========================================

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Cache de Poetry
.cache/
.poetry/

# Cache de embeddings (voluminoso)
src/embeddings_cache/
*.npy
*.npz

# Cache de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache de Docker
.docker/

# ========================================
# DIRECTORIOS DEL SISTEMA
# ========================================

# Directorios de configuración del usuario
.config/
.local/
.ssh/

# Directorios de herramientas de desarrollo
.cursor-server/
.nvm/
.pyenv/

# ========================================
# ARCHIVOS VOLUMINOSOS
# ========================================

# Backup del proyecto anterior (151M)
misuperprofev12/

# Archivos de lock voluminosos
poetry.lock

# Logs
*.log
logs/

# ========================================
# ARCHIVOS DE DESARROLLO
# ========================================

# Archivos temporales
*.tmp
*.temp
*~

# Archivos de IDE
.vscode/
.idea/
*.swp
*.swo

# ========================================
# ARCHIVOS DE BASE DE DATOS
# ========================================

# Dumps de base de datos
*.sql
*.dump
*.backup

# ========================================
# ARCHIVOS DE CONSTRUCCIÓN
# ========================================

# Archivos de build
build/
dist/
*.egg-info/

# ========================================
# ARCHIVOS DE TESTING
# ========================================

# Archivos de test
.pytest_cache/
.coverage
htmlcov/

# ========================================
# ARCHIVOS DE DOCUMENTACIÓN TEMPORAL
# ========================================

# Documentación generada
docs/_build/
site/

# ========================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# ========================================

# Archivos de memoria/documentación temporal
memory13/

# ========================================
# ARCHIVOS DE SEGURIDAD
# ========================================

# Certificados SSL
*.pem
*.key
*.crt

# ========================================
# ARCHIVOS DE MONITOREO
# ========================================

# Logs de aplicación
agent.log
backup.log
*.log.*

# ========================================
# ARCHIVOS DE RESPALDO
# ========================================

# Archivos de backup
*.bak
*.backup
*.old

# ========================================
# NOTA IMPORTANTE
# ========================================
# Este .gitignore está diseñado para incluir SOLO el código fuente
# y archivos de configuración esenciales del proyecto MiSuperProfe.
# Se excluyen archivos voluminosos, sensibles y temporales para
# mantener el repositorio de backup ligero y seguro. 