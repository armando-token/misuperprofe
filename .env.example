# ==============================================================================
# MiSuperProfe v12 - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace all placeholder values ('your_*_here') with your real configuration.
# 3. DO NOT commit the actual '.env' file into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_ENV=development
APP_NAME=NTID
APP_VERSION=1.0.0
APP_PORT=8001
API_V1_STR=/api/v1
DOMAIN=app.misuperprofe.com
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=misuper_usuario
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=misuper_bd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async connection string for FastAPI application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Synchronous connection string for Alembic migrations (psycopg2 driver)
POSTGRES_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ALEMBIC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. Cache & Message Broker (Redis)
# ------------------------------------------------------------------------------
# When running with Docker Compose, use 'redis' service hostname:
REDIS_URL=redis://redis:6379/0
# When running locally outside Docker, use:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Security & Authentication
# ------------------------------------------------------------------------------
# Static API Key for internal and administrative endpoint authentication (Bearer token)
API_KEY=your_secure_api_key_here

# General JWT configuration for internal session/user tokens
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth 2.0 JWT configuration for ChatGPT Team / external integrations
JWT_OAUTH_SECRET_KEY=your_oauth_secret_key_at_least_32_chars_long
JWT_OAUTH_ALGORITHM=HS256
JWT_OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 5. Artificial Intelligence & LLM Providers
# ------------------------------------------------------------------------------
# OpenAI API Key and Model
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# Google Gemini API Key and Model
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash-latest
GEMINI_HISTORY_MAX_CHARS=20000

# LangSmith Tracing & Observability (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=misuperprofe-v12

# ------------------------------------------------------------------------------
# 6. WordPress & MariaDB Integration (v12 Service Stack)
# ------------------------------------------------------------------------------
WORDPRESS_DB_HOST=db_wordpress_service:3306
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=your_secure_wordpress_db_password_here
WORDPRESS_SITE_URL=https://misuperprofe.com
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Security Salts (generate via https://api.wordpress.org/secret-key/1.1/salt/)
WORDPRESS_AUTH_KEY=put_your_unique_phrase_here
WORDPRESS_SECURE_AUTH_KEY=put_your_unique_phrase_here
WORDPRESS_LOGGED_IN_KEY=put_your_unique_phrase_here
WORDPRESS_NONCE_KEY=put_your_unique_phrase_here
WORDPRESS_AUTH_SALT=put_your_unique_phrase_here
WORDPRESS_SECURE_AUTH_SALT=put_your_unique_phrase_here
WORDPRESS_LOGGED_IN_SALT=put_your_unique_phrase_here
WORDPRESS_NONCE_SALT=put_your_unique_phrase_here

# Shared JWT secret between WordPress plugin and FastAPI backend
MI_SUPERPROFE_JWT_SECRET_KEY=your_shared_plugin_jwt_secret_here

# ------------------------------------------------------------------------------
# 7. External Integrations (Supabase - Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
